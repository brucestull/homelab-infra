# Nebula Sync configuration — copy to .env and fill in real values:
#   cp .env.example .env
#
# PRIMARY/REPLICAS format: URL|password  (pipe-separated)
# The primary is the source-of-truth Pi-hole; replicas are synced to match it.

PRIMARY=http://192.168.1.10|CHANGE_ME_PIHOLE_PASSWORD
REPLICAS=http://192.168.1.11|CHANGE_ME_PIHOLE_PASSWORD
FULL_SYNC=true
RUN_GRAVITY=true
CRON=*/15 * * * *
